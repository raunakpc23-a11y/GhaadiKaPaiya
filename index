<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OmniTrack | Productivity Calendar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="styles.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        jee: '#3b82f6',      // Blue
                        societies: '#a855f7',// Purple
                        college: '#22c55e',  // Green
                        personal: '#f97316'  // Orange
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-900 text-gray-100 font-sans h-screen flex overflow-hidden selection:bg-blue-500 selection:text-white">

    <!-- Sidebar Navigation -->
    <aside class="w-64 bg-gray-800 border-r border-gray-700 flex flex-col justify-between hidden md:flex">
        <div class="p-6">
            <h1 class="text-2xl font-bold tracking-wider mb-8 bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-500">OmniTrack</h1>
            <nav class="space-y-4">
                <button id="nav-calendar" class="w-full flex items-center space-x-3 text-left py-2 px-3 rounded-lg bg-gray-700 text-white transition-colors" onclick="switchTab('calendar')">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span>Calendar Views</span>
                </button>
                <button id="nav-analytics" class="w-full flex items-center space-x-3 text-left py-2 px-3 rounded-lg text-gray-400 hover:bg-gray-700 hover:text-white transition-colors" onclick="switchTab('analytics')">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    <span>Dashboard & Analytics</span>
                </button>
            </nav>
        </div>
        <div class="p-6">
            <button onclick="openModal()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-4 rounded-lg shadow-lg transition-all transform hover:scale-105">
                + New Task
            </button>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col h-full overflow-hidden">
        
        <!-- Header Controls -->
        <header class="bg-gray-800 border-b border-gray-700 p-4 md:p-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <div id="calendar-filters" class="flex flex-wrap gap-2">
                <button class="filter-btn active bg-gray-700 text-white px-4 py-1.5 rounded-full text-sm font-medium transition-colors border border-gray-600" data-filter="Central">Central (All)</button>
                <button class="filter-btn text-gray-400 hover:text-white px-4 py-1.5 rounded-full text-sm font-medium transition-colors border border-transparent hover:border-blue-500" data-filter="JEE">JEE</button>
                <button class="filter-btn text-gray-400 hover:text-white px-4 py-1.5 rounded-full text-sm font-medium transition-colors border border-transparent hover:border-purple-500" data-filter="Societies">Societies</button>
                <button class="filter-btn text-gray-400 hover:text-white px-4 py-1.5 rounded-full text-sm font-medium transition-colors border border-transparent hover:border-green-500" data-filter="College">College</button>
                <button class="filter-btn text-gray-400 hover:text-white px-4 py-1.5 rounded-full text-sm font-medium transition-colors border border-transparent hover:border-orange-500" data-filter="Personal">Personal</button>
            </div>
            
            <div id="date-controls" class="flex items-center space-x-4">
                <button onclick="changeDate(-1)" class="p-2 bg-gray-700 rounded hover:bg-gray-600">&larr;</button>
                <h2 id="current-date-display" class="text-lg font-semibold w-36 text-center">Today</h2>
                <input type="date" id="date-picker" class="hidden">
                <button onclick="changeDate(1)" class="p-2 bg-gray-700 rounded hover:bg-gray-600">&rarr;</button>
            </div>
        </header>

        <!-- Views Container -->
        <div class="flex-1 overflow-y-auto p-4 md:p-6 custom-scrollbar relative">
            
            <!-- Calendar View -->
            <div id="view-calendar" class="block max-w-5xl mx-auto w-full">
                <div id="task-list" class="space-y-4 pb-20">
                    <!-- Tasks injected here via JS -->
                </div>
                
                <!-- Empty State -->
                <div id="empty-state" class="hidden flex-col items-center justify-center mt-20 text-gray-500">
                    <svg class="w-16 h-16 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    <p class="text-lg">No tasks for this day. Enjoy your free time!</p>
                </div>
            </div>

            <!-- Analytics Dashboard View -->
            <div id="view-analytics" class="hidden max-w-5xl mx-auto w-full">
                <h2 class="text-2xl font-bold mb-6">Detailed Timetable Analysis</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <!-- Efficiency Card -->
                    <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md">
                        <h3 class="text-gray-400 text-sm font-semibold uppercase tracking-wider mb-2">Total Efficiency</h3>
                        <div class="flex items-end space-x-2">
                            <span id="stat-efficiency" class="text-4xl font-bold text-white">0%</span>
                            <span class="text-gray-400 mb-1">completed</span>
                        </div>
                    </div>
                    <!-- Most Delayed Card -->
                    <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md">
                        <h3 class="text-gray-400 text-sm font-semibold uppercase tracking-wider mb-2">Delay Insights</h3>
                        <div class="flex items-end space-x-2">
                            <span id="stat-delayed" class="text-xl font-bold text-red-400">None</span>
                        </div>
                        <p class="text-sm text-gray-500 mt-2">Category with most delays</p>
                    </div>
                    <!-- Total Tasks Card -->
                    <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md">
                        <h3 class="text-gray-400 text-sm font-semibold uppercase tracking-wider mb-2">Total Tasks Logged</h3>
                        <div class="flex items-end space-x-2">
                            <span id="stat-total" class="text-4xl font-bold text-white">0</span>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-800 p-6 rounded-xl border border-gray-700 shadow-md mb-8">
                    <h3 class="text-lg font-bold mb-4 border-b border-gray-700 pb-2">Time Allocation (Hours Spent)</h3>
                    <div id="time-allocation-bars" class="space-y-4">
                        <!-- Progress bars injected via JS -->
                    </div>
                </div>
                
            </div>
        </div>
    </main>

    <!-- Mobile Add Button -->
    <button onclick="openModal()" class="md:hidden fixed bottom-6 right-6 w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-xl text-white text-3xl z-40">
        +
    </button>

    <!-- Task Injection Modal -->
    <div id="task-modal" class="fixed inset-0 bg-black bg-opacity-60 hidden z-50 flex items-center justify-center px-4 backdrop-blur-sm transition-opacity">
        <div class="bg-gray-800 rounded-xl shadow-2xl w-full max-w-lg border border-gray-700 overflow-hidden">
            <div class="p-6 border-b border-gray-700 flex justify-between items-center bg-gray-900">
                <h3 id="modal-title" class="text-xl font-bold text-white">Add New Task</h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-white">&times;</button>
            </div>
            
            <form id="task-form" class="p-6 space-y-4">
                <input type="hidden" id="task-id">
                
                <div>
                    <label class="block text-sm font-medium text-gray-400 mb-1">Task Title</label>
                    <input type="text" id="task-title" required class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-400 mb-1">Date</label>
                        <input type="date" id="task-date" required class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-400 mb-1">Category</label>
                        <select id="task-category" required class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="JEE">JEE</option>
                            <option value="Societies">Societies</option>
                            <option value="College">College</option>
                            <option value="Personal">Personal</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-400 mb-1">Start Time</label>
                        <input type="time" id="task-start" required class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-400 mb-1">End Time</label>
                        <input type="time" id="task-end" required class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                
                <div id="status-container" class="hidden pt-2 border-t border-gray-700">
                    <label class="block text-sm font-medium text-gray-400 mb-1">Truthful Status</label>
                    <select id="task-status" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="Pending">Pending</option>
                        <option value="Completed">Completed</option>
                        <option value="Partially Completed">Partially Completed</option>
                        <option value="Delayed">Delayed</option>
                        <option value="Abandoned">Abandoned</option>
                    </select>
                </div>

                <div id="reflection-container" class="hidden">
                    <label class="block text-sm font-medium text-gray-400 mb-1">Reflection / Notes (Why didn't it happen?)</label>
                    <textarea id="task-reflection" rows="2" class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-red-500"></textarea>
                </div>

                <div class="pt-4 flex justify-end space-x-3">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 bg-gray-700 text-white rounded-lg hover:bg-gray-600">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-500 shadow-md">Save Task</button>
                </div>
            </form>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
